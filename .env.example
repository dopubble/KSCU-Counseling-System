DJANGO_SETTINGS_MODULE=kscu_counseling.settings.development
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (비우면 SQLite 사용 — 로컬 기본)
DATABASE_URL=

# PostgreSQL (Docker Compose 사용 시 아래 주석 해제)
# DATABASE_URL=postgres://kscu:kscu@localhost:5432/kscu_counseling

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Zoom API (Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# API 회의 Claim Host용 6자리 (Zoom web portal → Profile → Host Key 와 동일)
ZOOM_HOST_KEY=
# 관리자 캘린더 호스트 풀 (쉼표 구분). 비우면 host_01,host_02 기본값.
ZOOM_HOST_POOL=host_01,host_02

# 예약 캘린더 Google Calendar 스타일 UI (기본 True, 끄려면 false)
# CALENDAR_GCAL_UI=True

# --- Railway / Production (kscu_counseling.settings.production) ---
# DJANGO_SETTINGS_MODULE=kscu_counseling.settings.production
# SECRET_KEY=50자-이상-랜덤-문자열
# DEBUG=False
# ALLOWED_HOSTS=your-app.up.railway.app,.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}
# 과제·첨부 영구 저장 (택 1)
# MEDIA_ROOT=/data/media
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=ap-northeast-2
# AWS_S3_ENDPOINT_URL=
# 상세: docs/RAILWAY_DEPLOY.md

# Email — Gmail SMTP (docs/GMAIL_SMTP_SETUP.md)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.account@gmail.com
# Google 앱 비밀번호 16자 (공백 없이, 일반 비밀번호 아님)
EMAIL_HOST_PASSWORD=abcdefghijklmnop
DEFAULT_FROM_EMAIL=your.account@gmail.com
# 상담 신청·취소 요청 알림 수신(쉼표 구분)
STAFF_NOTIFY_EMAILS=admin@example.com
