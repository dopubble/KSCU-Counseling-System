DJANGO_SETTINGS_MODULE=kscu_counseling.settings.development
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (비우면 SQLite 사용 — 로컬 기본)
DATABASE_URL=

# PostgreSQL (Docker Compose 사용 시 아래 주석 해제)
# DATABASE_URL=postgres://kscu:kscu@localhost:5432/kscu_counseling

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Zoom API (Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Email — Gmail SMTP (docs/GMAIL_SMTP_SETUP.md)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.account@gmail.com
# Google 앱 비밀번호 16자 (공백 없이, 일반 비밀번호 아님)
EMAIL_HOST_PASSWORD=abcdefghijklmnop
DEFAULT_FROM_EMAIL=your.account@gmail.com
# 상담 신청·취소 요청 알림 수신(쉼표 구분)
STAFF_NOTIFY_EMAILS=admin@example.com
