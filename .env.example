DJANGO_SETTINGS_MODULE=kscu_counseling.settings.development
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (비우면 SQLite 사용 — 로컬 기본)
DATABASE_URL=

# PostgreSQL (Docker Compose 사용 시 아래 주석 해제)
# DATABASE_URL=postgres://kscu:kscu@localhost:5432/kscu_counseling

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Zoom API (Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# API 회의 Claim Host용 6자리 (Zoom web portal → Profile → Host Key 와 동일)
ZOOM_HOST_KEY=
# Licensed Zoom 사용자 이메일 (쉼표 구분) — host_01/02/03… 버퍼 엇갈림 배정 풀
ZOOM_LICENSED_USERS=sscukscu@gmail.com,sedulife@mail.kcu.ac
# 동시간대 비대면 상한 기본값(건). 운영 중 변경은 Django 관리자 → 비대면 Zoom 운영 설정
# DEFAULT_REMOTE_ZOOM_SIMULTANEOUS_CAPACITY=2
# 관리자 캘린더 호스트 라벨 (비우면 Licensed 사용자 수에 맞춰 host_01,host_02)
ZOOM_HOST_POOL=host_01,host_02

# 예약 캘린더 Google Calendar 스타일 UI (기본 True, 끄려면 false)
# Google Calendar 스타일 캘린더 (기본 켜짐, 끄려면 CALENDAR_GCAL_UI=false)
# CALENDAR_GCAL_UI=false

# --- Railway / Production (kscu_counseling.settings.production) ---
# DJANGO_SETTINGS_MODULE=kscu_counseling.settings.production
# SECRET_KEY=50자-이상-랜덤-문자열
# DEBUG=False
# ALLOWED_HOSTS=your-app.up.railway.app,.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}

# --- 미디어 영구 저장 (레거시 vs 동의서 분리) ---
# [레거시] 게시판·회기자료 — 기존 운영과 동일 (MEDIA_USE_S3=true 없이는 파일시스템)
# MEDIA_ROOT=/data/media
# MEDIA_USE_S3=true
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# [동의서 전용] 기존 파일 무영향 — CONSENT_AWS_* 만 설정
# CONSENT_AWS_STORAGE_BUCKET_NAME=
# CONSENT_AWS_ACCESS_KEY_ID=
# CONSENT_AWS_SECRET_ACCESS_KEY=
# CONSENT_AWS_S3_REGION_NAME=ap-northeast-2
# CONSENT_AWS_S3_ENDPOINT_URL=
# CONSENT_AWS_LOCATION=consents

# 상세: docs/RAILWAY_DEPLOY.md §9.1

# Email — Gmail SMTP (docs/GMAIL_SMTP_SETUP.md)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.account@gmail.com
# Google 앱 비밀번호 16자 (공백 없이, 일반 비밀번호 아님)
EMAIL_HOST_PASSWORD=abcdefghijklmnop
DEFAULT_FROM_EMAIL=your.account@gmail.com
# 상담 신청·취소 요청 알림 수신(쉼표 구분)
STAFF_NOTIFY_EMAILS=admin@example.com
